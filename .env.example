APP_NAME=ai-network-runbook-platform
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-different-random-secret-min-32-chars
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql+asyncpg://runbook:runbook@localhost:5432/runbook_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=runbook_embeddings

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

JWT_ALGORITHM=HS256
# For terminal/CLI-only usage (no UI), use long-lived tokens
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200   # 30 days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90        # 3 months
# For UI/browser usage, reduce to: 60 minutes / 7 days

LOG_LEVEL=INFO
LOG_FORMAT=json
